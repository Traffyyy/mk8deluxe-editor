<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="mk8deluxe editor" Width="1360" Height="850" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource BodyText}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{DynamicResource ScrollGrip}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
        <Border Background="Transparent"><Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="3"/></Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ScrollGripHover}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{DynamicResource Focus}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="VerticalScrollBar" TargetType="ScrollBar">
      <Grid Background="{DynamicResource Canvas}">
        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <!-- WPF uses half this resource value as the minimum grip length. -->
          <Track.Resources><sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">96</sys:Double></Track.Resources>
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HorizontalScrollBar" TargetType="ScrollBar">
      <Grid Background="{DynamicResource Canvas}">
        <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <Track.Resources><sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">96</sys:Double></Track.Resources>
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="24"/><Setter Property="Template" Value="{StaticResource VerticalScrollBar}"/>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="24"/><Setter Property="Width" Value="Auto"/>
        <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}"/>
      </Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource BodyText}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource ControlText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.80"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="StatisticsContextMenu" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border x:Name="MenuSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
          <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="StatisticsMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="MenuHighlight" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="10,8">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuHighlight" Property="Background" Value="{DynamicResource TabHover}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuHighlight" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuHighlight" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="StatisticsMenuSeparator" TargetType="Separator">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
        <Border Background="{DynamicResource Divider}" Height="1" Margin="8,4"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource HeaderText}"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="23,13" Margin="0,0,8,0">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TabText}"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource TabSelected}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource TabHover}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Header}"/><Setter Property="Foreground" Value="{DynamicResource HeaderText}"/>
      <Setter Property="Height" Value="42"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{DynamicResource GridBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/><Setter Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter Property="BorderThickness" Value="1"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontSize" Value="15"/><Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Style.Triggers><Trigger Property="Validation.HasError" Value="True">
        <Setter Property="Background" Value="{DynamicResource Invalid}"/><Setter Property="ToolTip" Value="Enter a whole number from 0 to 4294967295."/>
      </Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootLayout" Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="26,20">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid x:Name="PrimaryToolbar" Grid.Column="1" Width="420">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
          <Button x:Name="AudioButton" Width="44" Height="42" Padding="8" Background="#147D44" BorderBrush="#147D44" AutomationProperties.Name="Turn audio off" AutomationProperties.HelpText="Hover to adjust volume. Press Down to focus the volume slider.">
            <Viewbox Width="23" Height="23"><Grid Width="24" Height="24">
              <Path Fill="White" Data="M 2,9 L 7,9 L 12,5 L 12,19 L 7,15 L 2,15 Z"/>
              <Path x:Name="AudioWaves" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 15,8 C 18,10 18,14 15,16 M 18,5 C 23,9 23,15 18,19"/>
              <Path x:Name="AudioCross" Visibility="Collapsed" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 16,9 L 22,15 M 22,9 L 16,15"/>
            </Grid></Viewbox>
          </Button>
          <Button x:Name="ThemeButton" Grid.Column="1" Width="44" Height="42" Padding="8" ToolTip="Switch to dark mode" AutomationProperties.Name="Switch to dark mode">
            <Viewbox Width="22" Height="22"><Grid Width="24" Height="24">
              <Path x:Name="MoonIcon" Stroke="{DynamicResource BodyText}" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M 19,16 A 9,9 0 1 1 8,4 A 8,8 0 0 0 19,16 Z"/>
              <Path x:Name="SunIcon" Visibility="Collapsed" Stroke="{DynamicResource BodyText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 12,7 A 5,5 0 1 1 12,17 A 5,5 0 1 1 12,7 M 12,1 L 12,3 M 12,21 L 12,23 M 1,12 L 3,12 M 21,12 L 23,12 M 4,4 L 5.5,5.5 M 18.5,18.5 L 20,20 M 4,20 L 5.5,18.5 M 18.5,5.5 L 20,4"/>
            </Grid></Viewbox>
          </Button>
          <Button x:Name="OpenButton" Grid.Column="2" HorizontalAlignment="Left" Width="44" Height="42" Padding="8" ToolTip="Open Performance.bin · Ctrl+O" AutomationProperties.Name="Open Performance.bin">
            <Viewbox Width="23" Height="23"><Path Stroke="{DynamicResource BodyText}" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M 3,19 L 3,5 L 9,5 L 11,8 L 20,8 L 20,11 M 3,19 L 6,11 L 23,11 L 20,19 Z"/></Viewbox>
          </Button>
          <Button x:Name="SaveButton" Grid.Column="3" Width="44" Height="42" Padding="8" Background="{DynamicResource Accent}" Foreground="#FEFFFF" BorderBrush="{DynamicResource Accent}" Margin="0" ToolTip="Save a new copy · Ctrl+Shift+S" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Save a new copy" IsEnabled="False">
            <Viewbox Width="22" Height="22"><Grid Width="24" Height="24"><Path Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M 4,3 L 17,3 L 21,7 L 21,21 L 3,21 L 3,3 Z M 7,3 L 7,9 L 16,9 L 16,3 M 7,21 L 7,14 L 17,14 L 17,21 M 13,5 L 13,7"/></Grid></Viewbox>
          </Button>
          <TextBlock x:Name="TrackTitle" Grid.Row="1" Grid.ColumnSpan="4" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource BodyText}" Margin="0,6,0,0"/>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="26,16,26,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="FileNameText" Text="No file open" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock x:Name="FileDetailText" Text="Open Performance.bin to read its actual values." Margin="0,4,15,0" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <Grid x:Name="SecondaryToolbar" Grid.Column="1" Width="420" Height="42" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
        <Button x:Name="UndoButton" Width="44" Height="42" Padding="8" ToolTip="Undo the last change · Ctrl+Z" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Undo the last change" IsEnabled="False">
          <Viewbox Width="22" Height="22"><Path Stroke="{DynamicResource BodyText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 8,4 L 3,9 L 8,14 M 3,9 L 14,9 C 23,9 23,20 14,20 L 10,20"/></Viewbox>
        </Button>
        <Button x:Name="ResetButton" Grid.Column="1" Width="44" Height="42" Padding="8" ToolTip="Reset to the opened file's values" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Reset changes" IsEnabled="False">
          <Viewbox Width="22" Height="22"><Path Stroke="{DynamicResource BodyText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 3,4 L 3,10 L 9,10 M 3,10 A 9,9 0 1 1 4,17"/></Viewbox>
        </Button>
        <Border x:Name="SearchField" Grid.Column="2" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" CornerRadius="5" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="0,6">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Viewbox x:Name="SearchIcon" Width="22" Height="22" VerticalAlignment="Center"><Path Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M 10,3 A 7,7 0 1 1 10,17 A 7,7 0 1 1 10,3 M 15,15 L 21,21"/></Viewbox>
            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,0,10,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" ToolTip="Filter the current tab by name" AutomationProperties.Name="Search items"/>
            <TextBlock Grid.Column="1" Text="Search" IsHitTestVisible="False" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="26,0,26,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TabControl x:Name="CategoryTabs" Background="Transparent" BorderThickness="0" Padding="0">
        <TabItem Header="Karts  ·  41" Tag="PTBD"/><TabItem Header="Characters  ·  53" Tag="PTDV"/>
        <TabItem Header="Gliders  ·  15" Tag="PTWG"/><TabItem Header="Wheels  ·  22" Tag="PTTR"/>
        <TabItem Header="Hex" Tag="HEX"/>
      </TabControl>
      <DockPanel Grid.Row="1" Margin="0,12,0,12">
        <Button x:Name="StatsActionsButton" DockPanel.Dock="Right" Width="32" Height="28" Padding="5" Margin="10,0,0,0" ToolTip="Copy, paste and edit selected statistics" AutomationProperties.Name="Statistics actions">
          <Viewbox Width="20" Height="20"><Path Fill="{DynamicResource BodyText}" Data="M 3,10 A 2,2 0 1 1 3,14 A 2,2 0 1 1 3,10 M 12,10 A 2,2 0 1 1 12,14 A 2,2 0 1 1 12,10 M 21,10 A 2,2 0 1 1 21,14 A 2,2 0 1 1 21,10"/></Viewbox>
        </Button>
        <TextBlock x:Name="CategoryDescription" Text="Vehicle bodies · karts, bikes and ATVs" FontWeight="SemiBold"/>
        <TextBlock x:Name="ViewHint" Text="Double-click or F2 to edit · hover over headings for details" Foreground="{DynamicResource SecondaryText}" TextAlignment="Right"/>
      </DockPanel>
      <Grid Grid.Row="2">
        <DataGrid x:Name="StatsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeRows="False"
                  HeadersVisibility="Column" RowHeight="68" FrozenColumnCount="2" SelectionUnit="Cell" SelectionMode="Extended"
                  Background="{DynamicResource Surface}" Foreground="{DynamicResource BodyText}" RowBackground="{DynamicResource Surface}" BorderBrush="{DynamicResource GridBorder}" BorderThickness="1" GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource GridLine}" VerticalGridLinesBrush="{DynamicResource GridLine}"
                  EnableRowVirtualization="True" EnableColumnVirtualization="False"/>
        <Grid x:Name="HexComparisonPanel" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.Resources>
            <Style x:Key="HexTable" TargetType="DataGrid">
              <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
              <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
              <Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/>
              <Setter Property="CanUserResizeRows" Value="False"/><Setter Property="CanUserResizeColumns" Value="False"/>
              <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="28"/>
              <Setter Property="FrozenColumnCount" Value="1"/><Setter Property="SelectionUnit" Value="Cell"/>
              <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/>
              <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
              <Setter Property="Foreground" Value="{DynamicResource BodyText}"/><Setter Property="BorderBrush" Value="{DynamicResource GridBorder}"/>
              <Setter Property="BorderThickness" Value="1"/><Setter Property="GridLinesVisibility" Value="None"/>
              <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="False"/>
            </Style>
          </Grid.Resources>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource Header}" Padding="10,8"><TextBlock Text="Original · opened file" FontWeight="SemiBold" ToolTip="The unchanged bytes from the file you opened."/></Border>
            <DataGrid x:Name="OriginalHexGrid" Grid.Row="1" Style="{StaticResource HexTable}" AutomationProperties.Name="Original file bytes"/>
          </Grid>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource Header}" Padding="10,8"><TextBlock Text="Edited · current changes" FontWeight="SemiBold" ToolTip="The same file with your current edits, before saving a copy."/></Border>
            <DataGrid x:Name="HexGrid" Grid.Row="1" Style="{StaticResource HexTable}" AutomationProperties.Name="Edited file bytes"/>
          </Grid>
        </Grid>
        <Border x:Name="EmptyPanel" Background="{DynamicResource Empty}" BorderBrush="{DynamicResource GridBorder}" BorderThickness="1">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
            <TextBlock x:Name="EmptyTitle" Text="Start with your file." FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock x:Name="EmptyDescription" Text="Open Performance.bin to view images and statistics. Changes are saved to a new copy." TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryText}" FontSize="15"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Padding="26,14" Background="{DynamicResource Canvas}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready · works offline" Foreground="{DynamicResource StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <StackPanel x:Name="ChangeLegend" Grid.Column="1" Orientation="Horizontal">
          <Rectangle Fill="{DynamicResource Increase}" Stroke="{DynamicResource IncreaseBorder}" Width="10" Height="10" Margin="16,0,6,0"/><TextBlock Text="Increased" Foreground="{DynamicResource StatusText}"/>
          <Rectangle Fill="{DynamicResource Decrease}" Stroke="{DynamicResource DecreaseBorder}" Width="10" Height="10" Margin="14,0,6,0"/><TextBlock Text="Decreased" Foreground="{DynamicResource StatusText}"/>
          <TextBlock Text="  compared with the opened file" Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>
        <TextBlock x:Name="HexLegend" Grid.Column="1" Visibility="Collapsed" Text="Alternating colors: bookmarks · outlined bytes: changes" Foreground="{DynamicResource StatusText}" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Border x:Name="VolumePanel" Grid.RowSpan="4" Panel.ZIndex="50" Visibility="Collapsed" Width="250" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="16,12">
      <StackPanel>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Volume" FontWeight="SemiBold"/><TextBlock x:Name="VolumeValue" Grid.Column="1" Text="35%" Foreground="{DynamicResource SecondaryText}"/>
        </Grid>
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="35" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True" Height="26" AutomationProperties.Name="Music volume"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
