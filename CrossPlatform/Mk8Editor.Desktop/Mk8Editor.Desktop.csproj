<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Traffy</Company>
    <Product>mk8deluxe editor</Product>
    <ApplicationIcon>../../Source/Mk8Editor.App/App.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <ProjectReference Include="../Mk8Editor.Core/Mk8Editor.Core.csproj" />
    <EmbeddedResource Include="../../Source/Mk8Editor.App/Assets/*.png" LogicalName="Mk8Editor.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../Source/Mk8Editor.App/App.ico" LogicalName="Mk8Editor.App.ico" />
    <Content Include="../../Source/Mk8Editor.App/Audio/reference.wav" Link="Audio/reference.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
